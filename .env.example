# PostgreSQL. Use a pooled runtime URL and a direct migration URL.
DATABASE_URL="postgresql://user:password@pooler:6543/vehicle_scrap_yard?pgbouncer=true"
DIRECT_URL="postgresql://user:password@database:5432/vehicle_scrap_yard"

# Admin authentication. Generate the scrypt value as documented in README.md.
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Supabase Storage (optional)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# DVLA Vehicle Enquiry Service
DVLA_API_KEY="your-dvla-api-key"
DVLA_API_URL="https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles"

# Twilio WhatsApp (optional)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_FROM="447123456789"
RECIPIENT_WHATSAPP="447123456789"
NEXT_PUBLIC_RECIPIENT_WHATSAPP="447123456789"

# Optional metals provider
METALS_API_KEY="your-metals-api-key"
